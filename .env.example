# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/tradebinder.db

# ── TCGPlayer ─────────────────────────────────────────────────────────────────
# Apply at: https://developer.tcgplayer.com/
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=
TCGPLAYER_STORE_KEY=    # Your seller/store key

# ── eBay (production) ─────────────────────────────────────────────────────────
# Apply at: https://developer.ebay.com/
# App ID = EBAY_CLIENT_ID, Cert ID = EBAY_CLIENT_SECRET
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=      # RuName — only needed if using the OAuth flow
EBAY_REFRESH_TOKEN=     # Paste token from developer portal to skip OAuth entirely
# Find policy IDs at: ebay.com → Account → Site Preferences → Postage/Payment/Returns
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# ── eBay (sandbox) ────────────────────────────────────────────────────────────
# Used when EBAY_SANDBOX=true
EBAY_SANDBOX=false
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_SANDBOX_REDIRECT_URI=
EBAY_SANDBOX_REFRESH_TOKEN=
EBAY_SANDBOX_FULFILLMENT_POLICY_ID=
EBAY_SANDBOX_PAYMENT_POLICY_ID=
EBAY_SANDBOX_RETURN_POLICY_ID=

# ── App ───────────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=5
APP_BASE_URL=http://localhost:8000
FRONTEND_PORT=8080
