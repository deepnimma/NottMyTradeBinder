# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/tradebinder.db

# ── TCGPlayer ─────────────────────────────────────────────────────────────────
# Apply at: https://developer.tcgplayer.com/
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=
TCGPLAYER_STORE_KEY=    # Your seller/store key

# ── eBay ─────────────────────────────────────────────────────────────────────
# Apply at: https://developer.ebay.com/
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=      # RuName from your eBay developer app
EBAY_SANDBOX=false      # Set to true for sandbox testing

# ── App ───────────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=5
APP_BASE_URL=https://yourdomain.com  # Public URL of this app (for eBay OAuth callback)
FRONTEND_PORT=8080                   # Port to expose the web UI on (default: 8080)
